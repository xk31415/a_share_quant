# 环境变量模板 —— 复制为 .env 后按需修改。真实密钥严禁提交到版本库。
#
# 数据目录用命令行参数指定：
#     python scripts/run_baseline_backtest.py --data-dir data/processed

# 掘金量化 token（scripts/build_dataset.py --source gm 需要）
# 注意：当前代码不自动读取 .env 文件，需在 shell 里 set/export：
#     Windows: set GM_TOKEN=xxxx
#     bash:    export GM_TOKEN=xxxx
# GM_TOKEN=

# 预留：接入其它外部数据 API 时填写
# TUSHARE_TOKEN=
