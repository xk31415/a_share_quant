# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage

# 环境与密钥（.env 永不提交，只提交 .env.example）
.env

# 数据目录：只保留目录结构，不提交数据本体
data/raw/*
data/interim/*
data/processed/*
data/metadata/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep

# 实验产出（元数据 JSON 是否入库由使用者决定，默认不提交大文件）
results/*
experiments/*
!results/.gitkeep
!experiments/.gitkeep

# 编辑器
.idea/
.vscode/
