# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage

# 环境与密钥（.env 永不提交，只提交 .env.example）
.env

# 数据目录：只保留目录结构，不提交数据本体
# 为什么不入库：三份共 366 MB、bars.parquet 单文件 166 MB 超过 GitHub 100 MB 硬限制；
# update_dataset 每天整体重写 parquet，提交历史会膨胀到 GB 级；行情授权跟账号走。
# 入库的是 data/MANIFEST.json（内容指纹），别人重建后用它验证是不是同一份。
data/raw/*
data/interim/*
data/processed*/*
data/metadata/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep
!data/MANIFEST.json

# 实验产出（元数据 JSON 是否入库由使用者决定，默认不提交大文件）
results/*
experiments/*
!results/.gitkeep
!experiments/.gitkeep

# 实盘信号产出：每日的目标持仓与委托单属于本地交易记录，不入库。
# live/sample.json（冻结样本）要入库——它是组合身份，丢了就复现不了历史。
live/*/
live/_test_*
live/holdings.csv*
fills/
!live/sample.json

# 临时探针目录
_dstest/
_probe/

# 编辑器
.idea/
.vscode/

# 运行日志（拉数据 / 批量回测的输出，本地留档，不入库）
*.log

# 掘金账户密钥（token / account_id），只存服务器，不入库
config/gm_account.yaml
live/logs/
